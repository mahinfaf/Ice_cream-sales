import pandas as pd
import numpy as np
import pickle
from sklearn.linear_model import LinearRegression

# 1. Create sample dataset with two features
np.random.seed(42)
n_samples = 100

temperature = np.random.uniform(15, 35, n_samples)  # Temp between 15°C and 35°C
weekend = np.random.choice([0, 1], size=n_samples, p=[0.7, 0.3])  # 1 = Weekend, 0 = Weekday

# Sales formula: Base sales + Temp impact + Weekend boost + random noise
sales = 50 + (temperature * 12) + (weekend * 80) + np.random.normal(0, 15, n_samples)

df = pd.DataFrame({
    'temperature': temperature,
    'weekend': weekend,
    'sales': sales
})

# Save sample dataset to CSV
df.to_csv('ice_cream_data.csv', index=False)

# 2. Train the Multiple Linear Regression Model
X = df[['temperature', 'weekend']]
y = df['sales']

model = LinearRegression()
model.fit(X, y)

# 3. Save the trained model to model.pkl
with open('model.pkl', 'wb') as f:
    pickle.dump(model, f)

print("Model successfully trained and saved as 'model.pkl'!")
